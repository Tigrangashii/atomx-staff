# Kopjoje këtë file si .env dhe vendosi vlerat nga Supabase Dashboard.
NUXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NUXT_PUBLIC_SUPABASE_KEY=your-publishable-or-anon-key
# Vetëm për serverin; mos e përdor në komponentët e frontend-it.
NUXT_SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
